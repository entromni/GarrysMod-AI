event chat(Ply:entity, Said:string, _:number) 
{

    TEMPLAR = Said:explode(" ")

    if(Ply==owner() ? 1 : 0 ) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"Activate"+AI_Identification) 
        {
            Power = 1, # AI_Identification = round(random(1,10))
            hideChat(1)
            print("Robot successfully activated. To deactivate this robot type 'PowerDown' followed by this code: "+AI_Identification)
        }
    }

    if(Ply==owner() ? 1 : 0 ) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"ActivateAll" ) 
        {
            Power = 1
            hideChat(1)
            print("All robots successfully activated")
        }
    }

    if(Ply==owner() ? 1 : 0 ) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"PowerDown"+AI_Identification) 
        {
            Power = 0, # AI_Identification = round(random(1,10))
            hideChat(1)
            print("Robot successfully powered down. To activate this robot type 'Activate' followed by this code: "+AI_Identification)
        }
    }

    if(Ply==owner() ? 1 : 0 ) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"DeactivateAll" ) 
        {
            Power = 0
            hideChat(1)
            print("All robots successfully deactivated")
        }
    }

    if(Ply==owner() ? 1 : 0 ) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"WipeTeams" ) 
        {
            print("Entities wiped: " + Teams[1, array]:count())
            Teams[1, array] = array()
    #        print(Teams[1, array]:count())
    #        Teams[1, array]:clear()
            hideChat(1)
            print("Teams succesfully Whiped! | Left over: " + Teams[1, array]:count())
        }
    }
    
    if(Ply==owner() ? 1 : 0 ) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"AddToTeam" ) 
        {
            if(Components_3_Completed == 1) 
            {
            
                Teams[1, array] = Teams[1, array]:add(Components_3)#, print("NEW AI ADDED!")
                print(Teams[1, array]:count())
                print("Successfully added to team!")
            } else { print("Failed to add to team!") }
            hideChat(1)
    #        print("Teams succesfully created!")
        }
    }

    if(Power == 1) 

    {

    # Manual Over Ride (MOR)
    
        if(Ply==owner() ? 1 : 0 ) 
        { 
            if(TEMPLAR[1, string] == CommandPrefix+"MOR"+AI_Identification)
            {
                ManualOverRide = 1
                hideChat(1)
                print("Manual over-ride activated")
            } 
        }

        if(Ply==owner() ? 1 : 0 ) 
        { 
            if(TEMPLAR[1, string] == CommandPrefix+"SetWayPoint") 
            {
                WayPoint_Exists = 1
                
                WayPoint_List:pushVector(round(Ply:pos()))
                WayPoint = WayPoint_List[1, vector]
                
        #        holoCreate()
                
                if(WayPoint_List:exists(1)) 
                {
                    foreach(TempVar_2:number, TempVa_3:vector=WayPoint_List) 
                    {  
                        holoCreate(600+TempVar_2)  
                        holoPos(600+TempVar_2, TempVa_3)  
                        holoColor(600+TempVar_2, vec(255, 0, 0))
                    }
                }
        
                hideChat(1)
                print("Set waypoint to: "+round(WayPoint):toString())
            } 
        }
    
        # Manual Over Ride All (MORA)
        
        if(Ply==owner() ? 1 : 0 ) 
        { 
            if(TEMPLAR[1, string] == CommandPrefix+"MORA") 
            {
                ManualOverRide = 1
                hideChat(1)
                print("Manual over-rided all robots")
            }
        }
    
        # Opposite of MOR: "Ease Of Controls" (EOC)
            
        if(Ply==owner() ? 1 : 0 ) 
        { 
            if(TEMPLAR[1, string] == CommandPrefix+"EOC"+AI_Identification)
            {
                ManualOverRide = 0, Follow = 0
                hideChat(1)
                print("Manual over-ride de-activated")
        
            }
        }

    }
        
    if(ManualOverRide == 1) 
    {
        if(Ply==owner() ? 1 : 0 ) 
        { 
            # Forces a singular robot follow you.
            if(TEMPLAR[1, string] == CommandPrefix+"Follow"+AI_Identification)
            {
                Follow = 1
                hideChat(1)
                print("Robot is now following you...")

            }

        }
            
        if(Ply==owner() ? 1 : 0 ) 
        { 
            
            # Makes all robots follow you.
            if(TEMPLAR[1, string] == CommandPrefix+"FollowAll") 
            {
                Follow = 1
                hideChat(1)
                print("All robots are now following you...")

            }

        }
            
        if(Ply==owner() ? 1 : 0 ) 
        { 
            
            # Stops all robots from following.
            if(TEMPLAR[1, string] == CommandPrefix+"FollowAll") 
            {
                Follow = 1
                hideChat(1)
                print("All robots are now following you...")

            }

        }

        if(Ply==owner() ? 1 : 0 ) 
        { 
                
            # Disables targeting.
            if(TEMPLAR[1, string] == CommandPrefix+"TargetingOff"+AI_Identification) 
            {
                Targeting = 0
                hideChat(1)
                print("Successfully disabled targeting")

            }

        }

        if(Ply==owner() ? 1 : 0 ) 
        { 
                
            # Disables movement.
            if(TEMPLAR[1, string] == CommandPrefix+"MovementOff"+AI_Identification) 
            {
                Movement = 0
                hideChat(1)
                print("Successfully disabled movement")

            }

        }

    }

}

