            { #if(TempVar_1 >= Components:count()) { print("test") }
           
                TempVar_1+=1
        
                local V = Components[TempVar_1, entity]
                
                if((V:type() == "acf_gearbox")|(V:type() == "acf_gun")|(V:type() == "acf_ammo")|(V:type() == "acf_engine")|(V:type() == "acf_fueltank")|(V:type() == "ace_crewseat_driver")|(V:type() == "ace_crewseat_gunner")|(V:type() == "ace_crewseat_loader")) 
