                } 
        
                # Components_3_Completed = 0
                
                if(TempVar_1 >= Components:count()) { print("Components 3 Completed! | Count: " + Components_3:count()), Components_3_Completed = 1, break } # else { TempVar_1+=1 }
                #print("test")
            }   
            
        }
    
        # if(Teams[1, array]:exists(1) & !AnyfriendlyAI:isValid())
        if(Teams[1, array]:exists(1) & !AnyfriendlyAI:isValid())  
        { 
            
            if(!AI_Team_Members[1, table]:exists(AI_Identification) & !AI_Team_Members_Lock) 
            {
                AI_Team_Members[1, table][AI_Identification, entity] = Base
                AI_Team_Members_Lock = 1
                # print("ADDED")
            } 
        
            local AI_Team_Members_Keys = AI_Team_Members[1, table]:keys()
        
            AnyfriendlyAI_Storage = AI_Team_Members[1, table]
        
            if(AnyfriendlyAI_Storage[AI_Team_Members_Keys[AnyfriendlyAI_Index, string], entity]:isValid() & AnyfriendlyAI_Storage[AI_Team_Members_Keys[AnyfriendlyAI_Index, string], entity]:id() != Base:id()) 
            {
                # print(AnyfriendlyAI_Storage[AI_Team_Members_Keys[AnyfriendlyAI_Index, string], entity])
                AnyfriendlyAI = AnyfriendlyAI_Storage[AI_Team_Members_Keys[AnyfriendlyAI_Index, string], entity]
                # print("FOUND FRIENDLY AI")
            } else { AnyfriendlyAI_Index = AnyfriendlyAI_Index+1 }
    
            if(AnyfriendlyAI_Index > AnyfriendlyAI_Storage:count()) { AnyfriendlyAI_Index = 0 }
    
        }
   
    }
    
}

