                    }
                } else 
                {
                    # HuntY = Self:bearing(Target:pos())
                    HuntY = bearing(Base_Pos, ((Base_Pos + Self_Right) - Base_Pos):toAngle(), TarPos)
                }
            } else { HuntY = 0 }
        } else { HuntY = 0 }
        
        
        ### The following is for attacking & aiming:
        
        ## Aim trigger:
        
        if((Distance < 50000) & (HUNT == 1)|(Protect == 1)) {
            Aim = 1
        }
        
        else { 
            Aim = 0
        }
        
        ## Turret aiming:
        
        if(Aim == 1|Follow == 0 & Protect != 0) 
        {
            
            if(Target) 
            
            {
            
                ActivateTurret = 1
                
                timer("Aim", Aim_Frequency)
                
                if(clk("Aim"))
                {
                            
                    Slope = 0.87
                    Intercept = 0.68  
        
                    DT = 0.1
                            
                    # TarPos = Target:pos()
                    
                    TarVel = ($TarPos / DT)
        
                    GunPos = Turret:pos()
                                    
                    Dist = (GunPos:distance(TarPos))
        
                    local BasePlate_Vel = Base:vel()
        
                    local Temp_Index_2 = round(distance_to_index(Dist, 50000, Ballistics_Table_Elevation_Array[Turret:acfAmmoType(), table]:count()))
                    local True_Drop = Ballistics_Table_Elevation_Array[Turret:acfAmmoType(), table][Temp_Index_2, number]
                                
                    T = Ballistics_Table_Travel_Time_Array[Turret:acfAmmoType(), table][Temp_Index_2, number]
                                    
                    Coef = Dist * Slope / 10000 + Intercept
                        
                    Lead = (TarVel * Coef * T)
                                            
                    Drift = round(BasePlate_Vel * T)
                   
                    Drop = True_Drop
        
                    AimPos = (TarPos + Lead + vec(0,0,Drop) + Drift) 
        
                    rangerPersist(0)
                    rangerFlags("W E")
                    rangerFilter(Components)
                    rangerPersist(1)
                    LOSranger =  rangerOffsetHull(50000, GunPos, (Target:massCenter() - GunPos):normalized(), vec(6))
        
                    # holoCreate(5, LOSranger:pos())
                    # holoScale(5, vec(12))
                    
                    GunDir = (Turret:pos() -  (TarPos - Lead - vec(0, 0, -Drop) - Drift)) 
                    
                    holoCreate(5, Haxis:pos(), vec(0.3), Self:toWorld(ang(0, TurretAng:yaw(), 0)))
                    holoAlpha(5, 0)
                    
                    holoCreate(6, Vaxis:pos(), vec(0.3), Turret:angles():setRoll(0))
                    holoAlpha(6, 0)
                    
                    holoParent(6, 5)
                    holoParent(5, Self)
                    
                    Vaxis:parentTo(holoEntity(6))
                    Haxis:parentTo(holoEntity(5))
                    Turret:parentTo(holoEntity(6))
                    
                    TurretAng = angnorm(clamp(TurretAng - clamp(heading(vec(), TurretAng, Self:toLocalAxis(GunDir)), -360, 360), ang(-60,-360, 0), ang(60, 360, 0)))
                    
                    HaxisAngle = Self:toWorld(ang(0,clamp(TurretAng:yaw()+90,-360,360),0))
                    holoAng(5, HaxisAngle)
                    
                    VaxisAngle = ang(-clamp(TurretAng:pitch(),-60,60),90,0)
                    holoAng(6, holoEntity(5):toWorld(VaxisAngle))
                    
                    Insight = LOSranger:entity()
                    
                    rangerPersist(0)
                    
                    if(!Refill & Insight:isValid() & !(Whitelist[Insight:owner():steamID(), number]|Whitelist[Insight:steamID(), number])) 
                    { TurretFire = 1, RepeatOnFinish = 1, ForceCancel = 0 } else { TurretFire = 0, RepeatOnFinish = 0, ForceCancel = 1 }
                                
                    if(Insight:isValid() & Insight:id() != Target:id()) 
                    { LOS_Filter:pushEntity(Insight) }
                    
                    if(changed(Insight) & (Insight:id() == Target:id())) 
                    { 
                        Teams[3, table]:remove(Teams[3, table]:count()), Teams[3, table]:pushString("True")#, print("YES")  
                    } 
                    
                    if(changed(Insight) & !Insight) 
                    { 
                        Teams[3, table]:remove(Teams[3, table]:count()), Teams[3, table]:pushString("False")#, print("NO")  
                    } 
                                
                    if(Teams[3, table]:count() > AI_Team_Members[1, table]:count()) 
                    { # print("TOO MANY" + AI_Team_Members[1, table]:count():toString()), 
                        # Teams[3, table]:remove(Teams[3, table]:count()) 
                        Teams[3, table] = table()
                    }
                    
                    # local AI_Team_Members_Keys = AI_Team_Members[1, table]:keys()
                    
                    if(Teams[3, table]:count()) 
                    { # print("RAPE")
                        local Temp_Index_2 = 0
                        local Temp_True_Or_False = 0
                        
                        foreach(_:number, _:string=Teams[3, table]) 
                        { 
                                
                            Temp_Index_2 = Temp_Index_2 + 1
                            
                            if(Teams[3, table][Temp_Index_2, string] == "False") 
                            {                        
                                Temp_True_Or_False = Temp_True_Or_False + 1
                                
                                print("!!! OUT OF LINE OF SIGHT !!!")
                            } # else { print(Teams[3, table][Temp_Index_2, string]) }
                            
                            if(Temp_Index_2 >= Teams[3, table]:count()) { break }
                        }
                        
                        if(Temp_True_Or_False >= Teams[3, table]:count()) 
                        { 
                            Target = noentity(), 
                            Find_Array = array(), 
                            Teams[2, array] = array(), 
                            Teams[3, array] = array(), 
                            Teams[3, table] = table()#, 
                            print("!!! Completely Lost Target !!!") 
                        }
                    }
                                
                    rangerPersist(0)
                
                    stoptimer("Aim")
                
                }
            
            }
        
        }
        
        else { TurretFire = 0, ActivateTurret = 0, RepeatOnFinish = 0, ForceCancel = 1 }
        
        if(Target:isValid()) 
        {
            holoAng(587, (Target:boxCenterW() - RadarBase_Pos):toAngle())
            
            Remembrance = 0
            
            timer("Remembrance", 100)
        } elseif(!Target:isValid() & clk("Remembrance")) # elseif(!Target:isValid() && changed(Target:id())) 
        { # print("FUCK")
            
            Remembrance = 1
            
            holoAng(587, ((holoEntity(587):pos()-Prev_Target_Pos):toAngle()-ang(180, 0, 0)) + random(-1.01, 1.01)) 
            
            stoptimer("Remembrance")
        } elseif(Remembrance | Force_Target)
        { Pos_Switch = vec(0)
            
            if(Remembrance) 
            { 
                Pos_Switch = Prev_Target_Pos
            } 
            
            if(Force_Target) 
            { 
                Pos_Switch = (Overseer_TargetTo + Base:toLocal(RadarBase_Pos))
            }
            
            holoAng(587, ((Pos_Switch-RadarBase_Pos):toAngle()) + ang(random(-0.5, 0.5))) 
            
            if(Remembrance) 
            { 
                timer("Forget", Time_Till_Forget)
            } 
                
            if(clk("Forget")) 
            {
                Remembrance = 0
                stoptimer("Forget")
            }
            
        } elseif(!Target & !Target:isValid() & !Remembrance) 
        {    
            local Temp_Normal = Temp_Vec2:normalized()
            
            local Temp_Roll = Temp_Normal:x()
            local Temp_Pitch = Temp_Normal:y()  
            
            # holoAng(587, ang((random(-RADAR_PITCH_MAX, RADAR_PITCH_MAX)) * (Base_Pitch * Temp_Pitch), RadarScanRotation*RadarScanRotationRate, (random(-RADAR_PITCH_MAX, RADAR_PITCH_MAX) * (Base_Roll * Temp_Roll))))
            holoAng(587, ang((random(-RADAR_PITCH_MAX, RADAR_PITCH_MAX) / (sin(RadarScanRotation / 360) / RadarScanRotationRate)) * (Base_Pitch * Temp_Pitch), RadarScanRotation*RadarScanRotationRate, (1 * (Base_Roll * Temp_Roll))))
                            
            if(RadarScanRotation < 360) { RadarScanRotation++ } 
            else { RadarScanRotation = 0 } 
        }
        
            # holoAng(587, ang(0, 0, 0))
    }

### Raycasts: ####---------------------------------------------------------------------------####
### Raycasts: ####---------------------------------------------------------------------------####
### Raycasts: ####---------------------------------------------------------------------------####

## Update Frequency:
    
    timer("Raycast", Ray_Frequency)
    
    if(clk("Raycast")) 
    {
    
    ### Raycasts: ####---------------------------------------------------------------------------####
    
    ## Main:
    
    #FilterArray = Base:getConnectedEntities()
    #FilterArray:pushEntity(Base)
        
        if(Components:count() && changed(Components:count())) { print("Readjusting Components: " + Components:count()), Components = Base:getConnectedEntities() }
        
        rangerPersist(0)
        rangerFilter(Components)
        rangerHitWater(1)
        rangerHitEntities(1)
        rangerPersist(1)
            RangerLeft = rangerOffsetHull(Self:toWorld(vec(0,-50,10)), Self:toWorld(vec(-480,500,20)), RangerLeftHullSize)
        # rangerFilter(Components)
            RangerRight = rangerOffsetHull(Self:toWorld(vec(0,-50,10)), Self:toWorld(vec(480,500,20)), RangerRightHullSize)
        # rangerFilter(Components)
            RangerFront = rangerOffsetHull(Self:toWorld(vec(0,0,20)), Self:toWorld(vec(0,Length + (Speed * 7),60)), RangerFrontHullSize)
        # rangerFilter(Components)
            RangerBack = rangerOffsetHull(Self:toWorld(vec(0,0,20)), Self:toWorld(vec(0,-Length,60)), RangerBackHullSize)
        # rangerFilter(Components)
    #    rangerFlags("I")
        rangerPersist(0)
        rangerFilter(Components)
        rangerHitWater(0)
        rangerPersist(1)
            # RangerGroundCheck_Front = rangerOffsetHull(entity():toWorld(vec(0,(((Length + (Speed * 2)) / 2) * True_Speed_Normalized),128)), entity():toWorld(vec(0,((Length + (Speed * 2)) * True_Speed_Normalized),-Length)), vec(1))
            # RangerGroundCheck_Back = rangerOffsetHull(entity():toWorld(vec(0,(((Length + (Speed * 2)) / 2) * True_Speed_Normalized),128)), entity():toWorld(vec(0,((Length + (Speed * 2)) * True_Speed_Normalized),-Length)), vec(1))
            RangerGroundCheck_Front = rangerOffsetHull(Self:toWorld(vec(0,((Length + (Speed * 7)) / 2),128)), Self:toWorld(vec(0,(Length + (Speed * 7)),-Length)), vec(1))
            RangerGroundCheck_Back = rangerOffsetHull(Self:toWorld(vec(0,-((Length + (Speed * 7)) / 2),128)), Self:toWorld(vec(0,-(Length + (Speed * 7)),-Length)), vec(1))
        
        local Ranger_Water_Check_Left = rangerOffsetHull(RangerLeft:pos(), (RangerLeft:pos()-vec(0, 0, Length)), vec(1))
        local Ranger_Water_Check_Right = rangerOffsetHull(RangerRight:pos(), (RangerRight:pos()-vec(0, 0, Length)), vec(1))
        
        holoPos(721, Ranger_Water_Check_Left:pos())
        holoPos(722, Ranger_Water_Check_Right:pos())
        
        # holoAlpha(721, 255)
        # holoAlpha(722, 255)  
        
        # holoColor(722, vec(255, 0, 0))
            
        rangerPersist(0)
        
        Left_Ang = acos(RangerLeft:hitNormal():dot(vec(0, 0, 1)))
        Right_Ang = acos(RangerRight:hitNormal():dot(vec(0, 0, 1)))
    
        Front_Ang = acos(RangerFront:hitNormal():dot(vec(0, 0, 1)))
        Back_Ang = acos(RangerBack:hitNormal():dot(vec(0, 0, 1)))
        
        # holoAlpha(401, 255)  
        holoPos(401, RangerGroundCheck_Front:pos())
        
        FRONT = RangerFront:distance()
        BACK = RangerBack:distance()
        RIGHT = RangerRight:distance()/730.06848144531
        LEFT = RangerLeft:distance()/730.06848144531
        
        # print(RangerRight:distance())
    
        GROUNDCHECK_Front = RangerGroundCheck_Front:distance()
        GROUNDCHECK_Back = RangerGroundCheck_Back:distance()
        
        # print(vec2(GROUNDCHECK, True_Speed_Normalized))
    
        if(ShowRaycastHolos)
    
        {
            
            holoAlpha(586, 100)
            holoAlpha(587, 100)
            
            holoAlpha(721, 100)
            holoAlpha(722, 100)
            
            holoAlpha(1, 100)
            holoAlpha(2, 100)
            holoAlpha(3, 100)
            holoAlpha(4, 100)
            holoAlpha(401, 100)              
    
            holoPos(1, RangerLeft:pos())
            holoPos(2, RangerRight:pos())
            holoPos(3, RangerFront:pos())
            holoPos(4, RangerBack:pos())
            holoPos(401, RangerGroundCheck_Front:pos())            
    
    
            holoScale(1, RangerLeftHullSize/12)
            holoScale(2, RangerRightHullSize/12)
            holoScale(3, RangerFrontHullSize/12)
            holoScale(4, RangerBackHullSize/12)
    
            holoScale(721, vec(1)/12)
            holoScale(722, vec(1)/12)
            # holoScale(401, vec(1)/12)
            holoScale(401, RangerGroundCheckHullSize/12)
    
            holoColor(1, vec(0,0,255))
            holoColor(2, vec(0,255,0))
            holoColor(3, vec(255,0,0))    
            holoColor(4, vec(255,255,255))  
    
        }
    
        stoptimer("Raycast")
    }

### Movement: ####---------------------------------------------------------------------------####
### Movement: ####---------------------------------------------------------------------------####
### Movement: ####---------------------------------------------------------------------------####

    if(Movement == 1)
    { 
    
        timer("Movement", Movement_Frequency)
        
        if(clk("Movement")) 
        {
            
            if(Is_Locked) 
            { 
                if(Engines:count()) 
                { 
                    Average_RPM = 0
                    
                    for(I=0, Engines:count()+1, 1) 
                    { 
                        if(Engines:exists(I)) 
                        { if(!Engines[I, entity]:isValid()) { print("LOST ENGINE: " + toString(I)) Engines:remove(I) }
                            
                            Average_RPM = Average_RPM + Engines[I, entity]:acfRPM()
                                
                        }
                        
                        if(I >= Engines:count()) { break }
                    }
                    
                    Average_RPM = ((Average_RPM) / (Engines:count()))
                
                } else { Average_RPM = 0 }
            
            }
            
            # print(Average_RPM)
            
            Ang_Speed = abs(Base:angVelVector():length() / 17.6)
            
            Speed = (Base:vel():trueVec3Length() / 17.6)
            
            True_Speed = Speed
            
            # print(vec2(True_Speed, True_Speed_Normalized))
            
            Speed = abs(Speed)
            
            True_Speed_Normalized = (True_Speed / Speed)
            
            Engine_speed = Average_RPM  # Current engine RPM
            
            if(Speed<Speed2) { Gear_2 = 1, Desired_speed = Speed2 }
            if(Speed2<Speed) { Gear_2 = 2, Desired_speed = Speed3 }
            if(Speed3<Speed) { Gear_2 = 3, Desired_speed = Speed4 }
            if(Speed4<Speed) { Gear_2 = 4, Desired_speed = Speed5 }
            if(Speed5<Speed) { Gear_2 = 5, Desired_speed = Speed6 }
            if(Speed6<Speed) { Gear_2 = 6, Desired_speed = Speed7 }
            if(Speed7<Speed) { Gear_2 = 7, Desired_speed = Default_Desired_Speed }
            
            local RPM = clamp(Average_RPM, FullClutchRPM, NoClutchRPM)
            local Normalized = ((RPM - FullClutchRPM) / (NoClutchRPM - FullClutchRPM))
            Clutch = (1 - Normalized)
            
            local Cur_CVT_Ratio = calculate_cvt_ratio(Speed, Desired_speed, Average_RPM, Powerband_min, Powerband_max)
            CVT_Ratio = CVT_Averages:pushGetAvg(Cur_CVT_Ratio, 10)
            
            # print(vec2(RandomTurnState, RandomlyTurning))
                        
            Normalized_HuntY = (HuntY / 180)
            
            Clamped_Bearing = clamp(HuntY, -1, 1)
            
            # print(table(Front_Ang, Left_Ang, Right_Ang, Back_Ang))

            local Wall_Difference = abs(LEFT - RIGHT)
            local Strong_Wall_Preference = (Wall_Difference > 0.15)
            local Weird = (((FRONT < 500) & (FRONT > 320) & (Wall_Difference < 0.15)) | (GROUNDCHECK_Front > 320) | ((Wall_Difference < 0.15) & S & (BACK > 144)) )
            local Corridor = (((LEFT < 0.8) & (LEFT > 0.1)) & ((RIGHT < 0.8) & (RIGHT > 0.1)))
            
            local Has_Target = ((HUNT == 1) | (Follow == 1) | (Force_Target == 1)) # & (abs(Normalized_HuntY) > 0.05)
            local Target_Preference = 0
            
            if(Weird | ((LEFT < 0.99 & Left_Ang >= Ang_Ignore_Threshold) | (RIGHT < 0.99 & Right_Ang >= Ang_Ignore_Threshold) | (holoEntity(401):isUnderWater() | holoEntity(721):isUnderWater() | holoEntity(722):isUnderWater())))
            { TURN = 1, PREDICTION = clamp(perceptron(array(LEFT, RIGHT), 0, 1), 0, 1)  } else { TURN = 0, PREDICTION = 0 }
            
            if((TURN == 1)|(HUNT == 1)|(Follow == 1)|WayPoint_List:exists(1)|((Turn_Lock[1, number] == 1) & (Turn_Lock[1, number] == 1))) { CanRandomlyTurn = 0, RandomlyTurning = 0 }

            if(TURN == 0) 
            {
                # if(((FRONT + (40 + Speed)) < (Length + (Speed * 7))) & (FRONT > 100) & (Speed > 30)) 
                if((FRONT < Length) & (FRONT > 100) & (Speed > 30)) 
                {
                    Brake_Status = 1#, print("I HATE YOU!!!!")
                } elseif((holoEntity(401):isUnderWater() | (holoEntity(401):isUnderWater() & holoEntity(721):isUnderWater()) | (holoEntity(401):isUnderWater() & holoEntity(722):isUnderWater()))) 
                { if(Speed > 15) { Brake_Status = 1 }, Found_Water = 1, print("I LOVE YOU!!!!"), timer("Reverse", 100) } 
                else { Found_Water = 0, Brake_Status = 0 }
            } else { Brake_Status = 0 }
            
            local Front_Wall_Critical = ((FRONT < 320) | (Found_Water & !holoEntity(721):isUnderWater() & !holoEntity(722):isUnderWater()))
            
            if(CanRandomlyTurn) 
            {
                if(RandomTurnTimer > 0) { RandomTurnTimer-- }
                
                if(RandomTurnState == 0) {
                    if(RandomTurnTimer == 0) {
                        local RandomDecision = round(random(-2, 2))
                        
                        # print("Random decision: " + RandomDecision)
                        
                        if(RandomDecision == 1) {
                            # Turn left
                            RandomTurnState = 1
                            RandomTurnDirection = 1
                            RandomTurnDuration = 15
                            RandomTurnTimer = RandomTurnDuration
                            RandomlyTurning = 1
                            
                            # print("Starting LEFT turn")
                        }
                        elseif(RandomDecision == -1) {
                            # Turn right
                            RandomTurnState = 1
                            RandomTurnDirection = -1
                            RandomTurnDuration = 15
                            RandomTurnTimer = RandomTurnDuration
                            RandomlyTurning = 1
                            
                            # print("Starting RIGHT turn")
                        } 
                        else {
                            RandomTurnState = 2
                            RandomTurnDirection = 0
                            RandomTurnTimer = 40
                            RandomlyTurning = 0
                            
                            # print("Going straight (cooldown)")
                        }
                    }
                }
                
                elseif(RandomTurnState == 1) {
                    if(RandomTurnTimer > 0) {
                        if(RandomTurnDirection == 1) {
                            A = 1, D = 0 # Turn left
                            # print("LEFT FUCK")
                            RandomlyTurning = 1
                        } else {
                            A = 0, D = 1 # Turn right
                            # print("RIGHT FUCK")
                            RandomlyTurning = 1
                        }
                    } else {
                        RandomTurnState = 2
                        RandomTurnTimer = 120
                        RandomlyTurning = 0
                        
                        # print("1")
                        
                        # print("Finished turning, entering cooldown")
                    }
                }
                
                elseif(RandomTurnState == 2) {
                    
                    # print("2")
                    
                    if(RandomTurnTimer == 0) {
                        RandomTurnState = 0
                        RandomTurnTimer = 6 
                        RandomlyTurning = 0
                        
                        # print("Cooldown finished, ready for next decision")
                    }
                }
            } else {
                if(RandomTurnState != 0) {
                    RandomTurnState = 0
                    RandomTurnTimer = 0
                    RandomlyTurning = 0
                    
                    # print("3")
                    
                    # print("Random turning disabled - resetting")
                }
            }
            
            # else { CanRandomlyTurn = 1 }
            
            # print(PREDICTION)
                        
            if(Has_Target) {
                if((Normalized_HuntY < 0.9) & (Normalized_HuntY > 0)) { Target_Preference = 1 }
                elseif((Normalized_HuntY > -0.94) & (Normalized_HuntY < 0)) { Target_Preference = -1 }
                else { Target_Preference = 0 } 
            }
            
            if(Turn_Hold_Timer > 0) { Turn_Hold_Timer-- }
            
            local Current_Turn_Direction = 0
        
            if(Corridor & !Weird) 
            {  
                A = 0, D = 0 # print("LOSER!!!!")
                # print(vec2(A, D))
            }
                
            elseif(Weird) 
            {  
                A = 1, D = 0 # print("RAPE!!!!!!!!!!!!!")
                # print(vec2(A, D))
            }
            
            elseif(Front_Wall_Critical & LEFT > RIGHT & Left_Ang >= Ang_Ignore_Threshold & Right_Ang >= Ang_Ignore_Threshold & !Weird & !Corridor) 
            {  
                if(Strong_Wall_Preference | Last_Turn_Direction == 1 | Turn_Hold_Timer > 0) { # print("1")
                    if(Reversing & !Invert_Reverse_Steering) { A = 1, D = 0 } else { A = 0, D = 1 }  # Turn LEFT
                    Current_Turn_Direction = 1
                    if(Last_Turn_Direction != 1) { Last_Turn_Direction = 1, Turn_Hold_Timer = Has_Target ? (10-Ang_Speed) : (15-Ang_Speed) }
                } # print("LEFT")
            }
            
            elseif(Front_Wall_Critical & LEFT < RIGHT & Left_Ang >= Ang_Ignore_Threshold & Right_Ang >= Ang_Ignore_Threshold & !Weird) 
            {   
                if(Strong_Wall_Preference | Last_Turn_Direction == -1 | Turn_Hold_Timer >= 0) { # print("3")
                    if(Reversing & !Invert_Reverse_Steering) { A = 0, D = 1 } else { A = 1, D = 0 }  # Turn RIGHT
                    Current_Turn_Direction = -1
                    if(Last_Turn_Direction != -1) { Last_Turn_Direction = -1, Turn_Hold_Timer = Has_Target ? (10-Ang_Speed) : (15-Ang_Speed) }
                } # print("RIGHT")
            }
            
            elseif((holoEntity(721):isUnderWater() | (holoEntity(401):isUnderWater() & holoEntity(721):isUnderWater()))) 
            { 
                if(Reversing & !Invert_Reverse_Steering) { A = 1, D = 0 } else { A = 0, D = 1 }
                Current_Turn_Direction = 1
            }
            
            elseif((holoEntity(722):isUnderWater() | (holoEntity(401):isUnderWater() & holoEntity(722):isUnderWater()))) 
            { 
                if(Reversing & !Invert_Reverse_Steering) { A = 0, D = 1 } else { A = 1, D = 0 }
                Current_Turn_Direction = -1
            }
            
            elseif((LEFT < 0.99) | (RIGHT < 0.99) & !Weird & !Corridor) {
                
                if(((PREDICTION < 0.84) & (PREDICTION > 0.0)) & Right_Ang >= Ang_Ignore_Threshold & (Wall_Difference | Last_Turn_Direction != -1)) {
                    local Should_Use_Prediction = 1
                    if(Has_Target & Target_Preference == 1 & LEFT > 0.85 & RIGHT > 0.85) {
                        Should_Use_Prediction = PREDICTION > 0.8
                    }
                    
                    if(Should_Use_Prediction) {
                        D = 0, A = 1 # turn right
                        Current_Turn_Direction = -1
                        Last_Turn_Direction = -1, Turn_Hold_Timer = Has_Target ? (10-Ang_Speed) : (15-Ang_Speed)
                    }
                } 
                
                elseif((PREDICTION > 0.84) & Left_Ang >= Ang_Ignore_Threshold & (Wall_Difference | Last_Turn_Direction != 1)) {
                    local Should_Use_Prediction = 1
                    if(Has_Target & Target_Preference == -1 & LEFT > 0.85 & RIGHT > 0.85) {
                        Should_Use_Prediction = PREDICTION < 0.2 
                    }
                    
                    if(Should_Use_Prediction) {
                        A = 0, D = 1 # turn left
                        Current_Turn_Direction = 1
                        Last_Turn_Direction = 1, Turn_Hold_Timer = Has_Target ? 10-Ang_Speed : 15-Ang_Speed
                    }
                } else
                { 
                    if(Has_Target & Target_Preference != 0) {
                        if(Target_Preference == 1) { A = 1, D = 0, Current_Turn_Direction = 1 } 
                        else { A = 0, D = 1, Current_Turn_Direction = -1 }
                        Last_Turn_Direction = Target_Preference, Turn_Hold_Timer = 10
                        # print("RAPE")
                    } else { # if(Turn_Hold_Timer > 0) {
                        CanRandomlyTurn = 1
                        
                        if(!RandomlyTurning | (Turn_Lock[1, number] | Turn_Lock[2, number]))  
                        { # print("???? WHAT THE FUCk")
                            A = 0, D = 0, Current_Turn_Direction = 0
                            if(Turn_Hold_Timer == 0) { Last_Turn_Direction = 0 }
                        } # else { print("??? HMP") }
                    }
                }
            } else
            { 
                if(Has_Target & Target_Preference != 0) {
                    if(Target_Preference == 1) { A = 1, D = 0, Current_Turn_Direction = 1 } 
                    else { A = 0, D = 1, Current_Turn_Direction = -1 }
                    Last_Turn_Direction = Target_Preference, Turn_Hold_Timer = 10
                    # print("RAPE")
                } else { # if(Turn_Hold_Timer > 0) {
                    CanRandomlyTurn = 1
                    
                    if(!RandomlyTurning | (Turn_Lock[1, number] | Turn_Lock[2, number])) 
                    { # print("WHAT THE FUCk!!!!")
                        A = 0, D = 0, Current_Turn_Direction = 0
                        if(Turn_Hold_Timer == 0) { Last_Turn_Direction = 0 }
                    } # else { print("HMmmmmmmmmm") }
                }
            }
            
            # print(CanRandomlyTurn)
            
            if(((Current_Turn_Direction != 0) & changed(Current_Turn_Direction)) & !Turn_Lock[1, number] & !Turn_Lock[2, number]) {
                updateOscillationHistory(Current_Turn_Direction)
                # print(Current_Turn_Direction)
                if(detectOscillation()) {
                    Oscillation_Lock_Timer = Oscillation_Lock_Timer_Delay
                    Oscillation_History = table()
                    Last_Turn_Direction = 0
                    Turn_Hold_Timer = 0
                    Turn_Lock[1, number] = 1
                    # print("Oscillation detected - locking straight movement")
                }
            }
            
            if(Oscillation_Lock_Timer > 0) {
                Oscillation_Lock_Timer-- 
            }
            
            if(!Oscillation_Lock_Timer && changed(Oscillation_Lock_Timer)) 
            {
                Turn_Lock[1, number] = 0
            }
            
            if(Oscillation_History_Remove_Timer > 0) {
                Oscillation_History_Remove_Timer-- 
            }
            
            if(!Oscillation_History_Remove_Timer && changed(Oscillation_History_Remove_Timer)) 
            {
                Oscillation_History:remove(1), Oscillation_History_Remove_Timer = Oscillation_History_Remove_Delay#, print(Oscillation_History:count())
            }
            
            if(!changed(Current_Turn_Direction) & (Current_Turn_Direction != 0)) 
            {
                if(Consistent_Rotation_Timer > 0) {
                    Consistent_Rotation_Timer-- 
                }
                
                if(!Consistent_Rotation_Timer && changed(Consistent_Rotation_Timer)) 
                {                    
                    Oscillation_History = table()
                    
                    Turn_Lock[2, number] = 1, Consistent_Rotation_Timer = Consistent_Rotation_Timer_Delay, Consistent_Rotation_Timer_Unlock = Consistent_Rotation_Timer_Unlock_Delay
                    # print("lock 2")
                }
            }
            
            if(Consistent_Rotation_Timer_Unlock > 0 & Turn_Lock[2, number] == 1) {
                Consistent_Rotation_Timer_Unlock-- 
            }
            
            if(!Consistent_Rotation_Timer_Unlock && changed(Consistent_Rotation_Timer_Unlock)) 
            {
                Turn_Lock[2, number] = 0#, print("GIANT!!!")
            }
            
            # print(array(W, A, S, D))
                                
            # print(Turn_Lock)
            
            if(clk("Reverse")) { 
                
                 Reversing = 1
                
                timer("ReverseTimeout", 300)
            } elseif(clk("ReverseTimeout")) { 
                
                Reversing = 0
            
              stoptimer("Reverse")
              stoptimer("ReverseTimeout")
            }
            
            if(BACK < 144 & Reversing != 0) { Reversing = 0 }
            
            local Dynamic_BrakeSpeed = clamp(((SteeringBrakes + Speed) / (Ang_Speed + 1)), 0.1, 1)
            
            local Temp_Pitch_Important = Temp_Vec2:y()
            # print(Temp_Pitch_Important)
            
            if(!Neutral_Pivot & (((FRONT > 320) | ((BACK < 144) & (Temp_Pitch_Important >= -(Ang_Ignore_Threshold*1.5)))) | (Front_Ang <= Ang_Ignore_Threshold)) & ((GROUNDCHECK_Front < 420) & (Temp_Pitch_Important <= (Ang_Ignore_Threshold*1.5))  & (Temp_Pitch_Important >= -(Ang_Ignore_Threshold*1.5))) & (!Reversing & (FRONT > 30))) 
            { 
                if(((HuntY <= -80) & (HuntY >= -130)) & (((Distance < Complete_Theshold_Dist & Distance > 0) | (FollowDistance < Complete_Theshold_Dist & FollowDistance > 0) | (Friendly_AI_FollowDistance < Complete_Theshold_Dist & Friendly_AI_FollowDistance > 0)) & BACK > 144) & !Refill) 
                {
                    if(!A&!D) { W = 0, S = 1, Throttle = 100 } 
                    else { W = 0, S = 1, Throttle = clamp(100 - (Ang_Speed - clamp((Speed / (Ang_Speed + 2)), 0, Ang_Speed - 1)), 60, 100)  } 
                    # W = 0, S = 1, Throttle = 100
                    timer("Reverse", 100) 
                } 
                elseif(!Reversing) 
                { 
                    if(!A&!D) { W = 1, S = 0, Throttle = 100 } 
                    else { W = 1, S = 0, Throttle = clamp(100 - (Ang_Speed - clamp((Speed / (Ang_Speed + 2)), 0, Ang_Speed - 1)), 60, 100) } 
                    # W = 1, S = 0, Throttle = 100
                } 
            } elseif(!Neutral_Pivot & ((BACK > 144) | ((Back_Ang <= Ang_Ignore_Threshold) & (BACK > 30))) & ((GROUNDCHECK_Back < 420) & (Temp_Pitch_Important >= -(Ang_Ignore_Threshold*1.5)) & (Temp_Pitch_Important <= (Ang_Ignore_Threshold*1.5)))) 
            { 
                if(!A&!D) { W = 0, S = 1, Throttle = 100 }
                else { W = 0, S = 1, Throttle = clamp(100 - (Ang_Speed - clamp((Speed / (Ang_Speed + 2)), 0, Ang_Speed - 1)), 60, 100) } 
                # W = 0, S = 1, Throttle = 100
                timer("Reverse", 100)
            }
            
            if((Turn_Lock[1, number] == 0) & (Turn_Lock[2, number] == 0) & (Consistent_Rotation_Timer <= (Consistent_Rotation_Timer_Delay / 2)) & TURN & !S) 
            { 
                local Can_Escape = 0
                
                # print("SIGMOID!!!!")
                
                if(A & LEFT > 0.99 & Left_Ang >= Ang_Ignore_Threshold) { Can_Escape = 1 } 
                elseif(D & RIGHT > 0.99 & Right_Ang >= Ang_Ignore_Threshold) { Can_Escape = 1 }
                elseif(FRONT > 450 & Front_Ang >= Ang_Ignore_Threshold) { Can_Escape = 1 }
                
                # if(Neutral_Pivot & !changed(Neutral_Pivot)) 
                # { 
                #     if(!clk("PivotTimer")) { timer("PivotTimer", 2000) }
                #     elseif(clk("PivotTimer")) { print("PIVOT 22222"), Can_Escape = 1, stoptimer("PivotTimer") }
                # }
                # else { stoptimer("PivotTimer") }
            
                # if((Speed+Ang_Speed) > Neutral_Pivot_Threshold_Speed_Maximum & !Can_Escape)
                # { Neutral_Pivot = 0 }
                
                # if((((Speed+Ang_Speed) <= Neutral_Pivot_Threshold_Speed_Minimum) & ((Speed+Ang_Speed) > 0) & !Can_Escape))
                # { 
                    # if(!Can_Escape) { Neutral_Pivot = 1 }
                    # else { Neutral_Pivot = 0 }
                # }
                                    
                if(Can_Escape) { Neutral_Pivot = 0 }
                else { Neutral_Pivot = 1 }
                
            } elseif(S & Neutral_Pivot) { Neutral_Pivot = 0 } else { Neutral_Pivot = 0 }
            
            if(!Neutral_Pivot) 
            {
                if(W) 
                { 
                    if(!Use_8_Speed_As_Reverse) 
                    {
                            RTransfer["Gear",number]=1, 
                            LTransfer["Gear",number]=1, 
                            Gear = Default_Gear
                    } else 
                    {
                        if(Use_Transfers_As_Reverse) 
                        {
                            RTransfer["Gear",number]=Gear_2, 
                            LTransfer["Gear",number]=Gear_2 
                        } else 
                        {
                            RTransfer["Gear",number]=1, 
                            LTransfer["Gear",number]=1 
                        }
                            Gear = Default_Gear
                    }
                    
                    # if(Speed > Neutral_Pivot_Threshold_Speed_Maximum) 
                    # { Neutral_Pivot = 0 }
                    
                    # if(Speed < Neutral_Pivot_Threshold_Speed_Minimum) 
                    # { Neutral_Pivot = 1 }
                } 
                
                if(S) 
                { # print("LOL")
                    if(!Use_8_Speed_As_Reverse) 
                    {
                        if(Use_Transfers_As_Reverse) 
                        {
                            RTransfer["Gear",number]=2, 
                            LTransfer["Gear",number]=2, 
                            Gear = Default_Gear
                        } elseif(!Use_Transfers_As_Reverse) 
                        {
                            RTransfer["Gear",number]=1, 
                            LTransfer["Gear",number]=1,
                            Gear = Reverse_Gear
                        }
                    } else 
                    {
                        if(Use_Transfers_As_Reverse) 
                        {
                            RTransfer["Gear",number]=Gear_2, 
                            LTransfer["Gear",number]=Gear_2, 
                            Gear = Default_Gear
                        } elseif(!Use_Transfers_As_Reverse) 
                        {
                            RTransfer["Gear",number]=1, 
                            LTransfer["Gear",number]=1,
                            Gear = Reverse_Gear
                        }
                    }
                    
                    # Neutral_Pivot = 0
                } 
            }
            
            if((A|D)&((Turn_Lock[1, number] == 0) & (Turn_Lock[2, number] == 0)))
            { if(!Neutral_Pivot) 
                { # print("FUCK YOUUUUU!!!!!") 
                    
                    # print("RAPE")
                    
                    # if(D) 
                    if((D&W)|(A&S))
                    { # print("RIGHT")
                        LTransfer["Left Clutch",number]=1,
                        LTransfer["Right Clutch",number]=1,
                        LTransfer["Left Brake",number]=Dynamic_BrakeSpeed,
                        LTransfer["Right Brake",number]=Dynamic_BrakeSpeed,
                    
                        RTransfer["Right Clutch",number]=Clutch,
                        RTransfer["Left Clutch",number]=Clutch,    
                        RTransfer["Right Brake",number]=0,
                        RTransfer["Left Brake",number]=0 
                    } # elseif(A) 
                    
                    if((A&W)|(D&S)) 
                    { # print("LEFT")
                        RTransfer["Right Clutch",number]=1,
                        RTransfer["Left Clutch",number]=1,
                        RTransfer["Left Brake",number]=Dynamic_BrakeSpeed,
                        RTransfer["Right Brake",number]=Dynamic_BrakeSpeed,
                        
                        LTransfer["Left Clutch",number]=Clutch,
                        LTransfer["Right Clutch",number]=Clutch,
                        LTransfer["Left Brake",number]=0,
                        LTransfer["Right Brake",number]=0
                     }
                 } elseif(Neutral_Pivot) 
                { # print("NIGGER!!!!!") 
                    if((D&W)|(A&S))
                    # if(D)
                    { 
            
                        LTransfer["Gear",number]=2,
                        LTransfer["Left Clutch",number]=0,
                        LTransfer["Right Clutch",number]=0,
                        LTransfer["Left Brake",number]=0,
                        LTransfer["Right Brake",number]=0,
                        
                        RTransfer["Gear",number]=1, 
                        RTransfer["Right Clutch",number]=0,
                        RTransfer["Left Clutch",number]=0,
                        RTransfer["Right Brake",number]=0,
                        RTransfer["Left Brake",number]=0 
                    } # elseif(A) 
                    
                    if((A&W)|(D&S))
                    { 
                        RTransfer["Gear",number]=2, 
                        RTransfer["Right Clutch",number]=0,
                        RTransfer["Left Clutch",number]=0,
                        RTransfer["Right Brake",number]=0,
                        RTransfer["Left Brake",number]=0   
                                  
                        LTransfer["Gear",number]=1,
                        LTransfer["Left Clutch",number]=0,
                        LTransfer["Right Clutch",number]=0,
                        LTransfer["Left Brake",number]=0,
                        LTransfer["Right Brake",number]=0
                    }
                }
                
                # print(Turn_Lock)
                
            } # elseif((Turn_Lock[1, number] == 1) | (Turn_Lock[2, number] == 1)) { print("MAGGOT!!!") }
            
            
            elseif(!A&!D&!Neutral_Pivot) 
            { 
                if(Brake_Status) 
                { # print("BRAKE!!!!")
                    LTransfer["Left Clutch",number]=1,
                    LTransfer["Right Clutch",number]=1,
                
                    RTransfer["Right Clutch",number]=1,
                    RTransfer["Left Clutch",number]=1,
            
                    RTransfer["Left Brake",number]=Brake_Force,
                    RTransfer["Right Brake",number]=Brake_Force,
                    
                    LTransfer["Left Brake",number]=Brake_Force,
                    LTransfer["Right Brake",number]=Brake_Force
                } 
                
                if(!Brake_Status) 
                { # print("FUCK YOUUUUU!!!!!") 
                    LTransfer["Left Clutch",number]=Clutch,
                    LTransfer["Right Clutch",number]=Clutch,
                
                    RTransfer["Right Clutch",number]=Clutch,
                    RTransfer["Left Clutch",number]=Clutch,
                    
                    RTransfer["Left Brake",number]=0,
                    RTransfer["Right Brake",number]=0,
                    
                    LTransfer["Left Brake",number]=0,
                    LTransfer["Right Brake",number]=0
                } # else 
                # { 
    #[                LTransfer["Left Clutch",number]=0,
                    LTransfer["Right Clutch",number]=0,
                
                    RTransfer["Right Clutch",number]=0,
                    RTransfer["Left Clutch",number]=0,
                    
                    RTransfer["Left Brake",number]=0,
                    RTransfer["Right Brake",number]=0,
                    
                    LTransfer["Left Brake",number]=0,
                    LTransfer["Right Brake",number]=0]#
                # } # else { }
            }
            
            stoptimer("Movement")
        }
    }
} 

if(!Power) 
{ 
    interval(Frequency), 
    TurretFire = 0, 
    ActivateTurret = 0,
    RepeatOnFinish = 0, 
    ForceCancel = 1
} else { interval(Frequency) }

## Resets Chip:

if(dupefinished()) { reset() }

runOnLast(1)

if(last()) 
{ 
    if(AI_Team_Members[1, table]:exists(AI_Identification)) 
    { 
        if(Scouts[4, table][1, array][2, string] == AI_Identification) 
        {
            print(AI_Identification + " Declining Command")
            Scouts[4, table] = table()
        }
        
        print("Begone with thy heracy machine..."), 
        AI_Team_Members[1, table]:remove(AI_Identification) 
    }  
}

