            elseif(!Target:isValid() & AnyfriendlyAI:isValid() & HasTeam & (Friendly_AI_FollowDistance < Friendly_AI_PreferredFollowRadius) & ((FollowDistance > 5000) | !FollowDistance) & !Scouts[4, array]:exists(1)) 
            { 
