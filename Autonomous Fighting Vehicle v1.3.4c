if(Overseer:isAlive()) 
{ timer("Command_Delay", Frequency) 
    
    if(clk("Command_Delay"))
    {
        if(Overseer_System["Commands", table]["AI_Individual_Commands_Data", table]:count()) 
        {   
            local DATA = Overseer_System["Commands", table]["AI_Individual_Commands_Data", table][AI_Identification, table]
            
            if(DATA:count()) 
            {
                
                local Resolved_Status = DATA["Resolved?", number]
                local Prev_Command = Cur_Command
                Cur_Command = DATA["Active Command", string]
                local Value = Commands[Cur_Command, number]
                
                if(!Resolved_Status) 
                { 
                    if(Value == 1) 
                    { if(Power & Prev_Command == Cur_Command) { Power = !Power }
                        Power = 1, Overseer_System["Commands", table]["AI_Individual_Commands_Data", table][AI_Identification, table]["Resolved?", number] = 1
                        
                        hint("Activated All AI!", 3)
                    }
            
                    elseif(Value == 2) 
                    { if(Force_Target & Prev_Command == Cur_Command) { Force_Target = !Force_Target }
                        Force_Target = 1, Overseer_System["Commands", table]["AI_Individual_Commands_Data", table][AI_Identification, table]["Resolved?", number] = 1
                        
                        hint("AI are now moving towards/looking at aimpos!", 3)
                    }
                     
                    elseif(Value == 3) 
                    { if(Follow & Prev_Command == Cur_Command) { Follow = !Follow }
                        Follow = 1, Overseer_System["Commands", table]["AI_Individual_Commands_Data", table][AI_Identification, table]["Resolved?", number] = 1
                        
                        hint("All AI are now following you!", 3)
                    } else { print("WTF LOL"), Overseer_System["Commands", table]["AI_Individual_Commands_Data", table][AI_Identification, table]["Resolved?", number] = 1 }
                }
                
                if(Resolved_Status) 
                {                
                    Overseer_System["Commands", table]["AI_Individual_Commands_Data", table]:remove(AI_Identification)
                    stoptimer("Command_Delay")
                }
            }
        }
    }
}

