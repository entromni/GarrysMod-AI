    function number vector:trueVec3Length()
    {
        return (This:x() + This:y() + This:z())
    }
    
    function number vector:trueVec2Length()
    {
        return (This:x() + This:y())
    }
    
    function distance_to_index(Distance:number, Max_distance:number, Array_Count:number) {
        local Normalized = (Distance / Max_distance)
        
        local Index = floor(Normalized * (Array_Count - 1)) + 1
        
        return min(Array_Count, max(1, Index))
    }

    function number array:pushGetAvg(Number:number, Samples:number) {
        if(This:count() > Samples) {
            This:shift()
        }
        
        This:pushNumber(Number)
        
        return This:average()
    }

    function number calculate_cvt_ratio(Current_speed:number, Ideal_Speed:number, Engine_rpm:number, Powerband_min:number, Powerband_max:number) 
    {
        if(Engine_rpm < Powerband_min) 
        {
            return Minimum_CVT_Ratio 
        } elseif(Engine_rpm > Powerband_max) 
        {
            return Maximum_CVT_Ratio
        } else {
            local Powerband_range = (Powerband_max - Powerband_min)
            local Rpm_within_powerband = (Engine_rpm - Powerband_min)
                        
            local Ratio_rpm = ((CVT_Ratio_RPM_Multiplier) * (Rpm_within_powerband / Powerband_range))
            
            local Ratio_speed = ((CVT_Ratio_Speed_Multiplier) * (Current_speed / Ideal_Speed))
            
            local Final_ratio = max(Ratio_rpm, Ratio_speed)
        
            return Final_ratio
        }
    }
    
    function detectOscillation() {
        if(Oscillation_History:count() < Oscillation_Threshold) { return 0 }
        
        local Changes = 0
        for(I = 2, Oscillation_History:count()) {
            if(Oscillation_History[I, number] != Oscillation_History[I-1, number]) {
                Changes++
            }
        }
        
        return (Changes >= 3)
    }
    
    function updateOscillationHistory(Direction) {
        Oscillation_History:pushNumber(Direction)
        if(Oscillation_History:count() > Oscillation_Threshold) {
            Oscillation_History:removeNumber(1)
        }
    }
    
    function number mph_to_degrees_per_second(Angular_velocity_mph:number) 
    {
        local Miles_to_feet = 5280
        local Circumference_degrees = 360
    
        local Velocity_fps = Angular_velocity_mph * Miles_to_feet
    
        local Circumference_feet = 2 * _PI * Miles_to_feet
    
        local Time_seconds = 3600
    
        local Degrees_per_second = Circumference_degrees / Time_seconds
    
        local Angular_velocity_deg_per_sec = ((Velocity_fps / Circumference_feet * Degrees_per_second) * (180 / _PI))
    
        return Angular_velocity_deg_per_sec 
    }
    
    function updatePosition() 
    {
        local Circle_Center = Target:massCenter()
        rangerPersist(0)
        rangerFlags(" ")
        rangerPersist(1)
        local Temp_Ranger = rangerOffsetHull(700, Circle_Center, (Circle_NewPosition - Circle_Center):normalized(), vec(1))
        rangerPersist(0)
        rangerFlags("E")
        rangerPersist(0)
        
        local Temp_FlankPos = (Target:pos()-Flankpos)
        local Distance_To_Flank = Temp_FlankPos:distance(Self:pos())
                        
        local Follow_Circle_Distance = Temp_Ranger:distance()
        local Follow_Circle_Speed = 30
        local Circle_Time = curtime()
        # local Circle_Angle = Circle_Time * (Follow_Circle_Speed / ((Distance - ((Speed / Ang_Speed + 1))) + 1))
        # local Circle_Angle = Circle_Time * clamp((Follow_Circle_Speed - Distance ), 0, Follow_Circle_Speed)
        # local Circle_Angle = Circle_Time * clamp((Follow_Circle_Speed / (Distance_To_Flank + 1)), 0, Follow_Circle_Speed)
        # local Circle_Angle = Circle_Time * clamp((Follow_Circle_Speed + ((Speed / (Ang_Speed + 1)) / 100)), 0, Follow_Circle_Speed * 2)
        local Circle_Angle = Circle_Time * Follow_Circle_Speed
        local Circle_Offset = vec(cos(Circle_Angle), sin(Circle_Angle), 0) * Follow_Circle_Distance
        Circle_NewPosition = Circle_Center + Circle_Offset
        holoAlpha(417, 255*ShowRaycastHolos)
        holoPos(417, Circle_NewPosition)
    }
    
    function updatePosition_2() 
    {
        local Circle_Center = owner():massCenter()
        local Follow_Circle_Distance = 1500
        local Follow_Circle_Speed = 20
        local Circle_Time = curtime()
        local Circle_Angle = Circle_Time * Follow_Circle_Speed
        local Circle_Offset = vec(cos(Circle_Angle), sin(Circle_Angle), 0) * Follow_Circle_Distance
        Circle_NewPosition = Circle_Center + Circle_Offset
        holoPos(417, Circle_NewPosition)
    }

    function number perceptron(X:array, Output:number, Predict:number) {
        local OutputP = 0
        if (Predict == 1){
            foreach(I:number, Value:number=X){
                OutputP += Value*Weights[I, number]
            }
            OutputP += Bias*Weights[Weights:count(), number]
            return OutputP
        } else {
            foreach(I:number, Value:number=X){
                OutputP += Value*Weights[I, number]
            }
            OutputP += Bias*Weights[Weights:count(), number]
            local Error = Output - OutputP
            foreach(I:number, Value:number=X){
                Weights[I, number] = Weights[I, number] + (Lr*Error*Value)
            }
            Weights[Weights:count(), number] = Weights[Weights:count(), number] + (Lr*Error*Bias)
            return Error
        }
    }
    
    function vector entity:get_aim_pos() 
    {
        return This:aimPos()
    }
} elseif(Components_3:count() & Components:count() & Is_Locked != 1) 
{
    if(Is_Locked == -3) 
    {
        foreach(Temp_Index_1:number, Engine:entity=Components_3) 
        { 
            if(Engine:type() == "acf_engine") { Engines:pushEntity(Engine) } 
            if(Temp_Index_1 >= Components_3:count()) { Is_Locked = -2, print("Engines Table Complete | Found: " + Engines:count():toString()), break }
        }
        
        if(Is_Locked == -2) 
        {         
            foreach(Temp_Index_2:number, Wheel:entity=Components) 
            {
                if(Wheel:type() == "prop_physics" & Wheel_Model_List[Wheel:model(), number]) { Wheels:pushEntity(Wheel), Wheel:propInertia(Wheel_Inertia), Wheel:propSetBuoyancy(0), Wheel:propDrag(0) }
                if(Temp_Index_2 >= Components:count()) { Is_Locked = -1, print("Wheels Table Complete | Found: " + Wheels:count():toString()), break }
            }
            
            if(Is_Locked == -1) 
            {
                I = 0
                while(I < 10) 
                {
                    # Train perceptron
                    perceptron(array(0.39233632596442,0.16762585050069), 1, 0)
                    perceptron(array(0.99999949526326,0.45710900470337), 0, 0)
                    perceptron(array(0.21212606989933,0.99999966057359), 1, 0)
                    perceptron(array(0.034481909188091,0.84807623103423), 1, 0)
                    perceptron(array(0.99999967258184,0.32195874883168), 0, 0)
                    perceptron(array(0.26891777078516,0.99999963927501), 1, 0)
                    perceptron(array(0.99999978785417,0.21938599110773), 0, 0)
                    perceptron(array(0.20990440166086,0.045841163577799), 0, 0)
                    perceptron(array(0.99999987812547,0.60804732613576), 1, 0)
                    perceptron(array(0.74327043512191,0.9999994432203), 1, 0)
                    
                    if(I >= 9) { Is_Locked = 0, break } else { I+=1 }
                }
                
                if(Is_Locked == 0) 
                {
                    foreach(Temp_Index_3:number, Gun:entity=Components_3) 
                    {
                        if(Gun:type() == "acf_gun") { Guns:pushEntity(Gun) }
                        if(Temp_Index_3 >= Components_3:count()) 
                        { 
                            Is_Locked = 1
                            print("Guns Table Complete | Found: " + Guns:count():toString())
                            Turret = Guns[1, entity]
                            break 
                        }
                    }
                }
            }
        }
    }
}

event chat(Ply:entity, Said:string, _:number) 
{
    local TEMPLAR = Said:explode(" ")

    Is_Owner = Ply == owner() ? 1 : 0

    if(Is_Owner) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"Activate"+AI_Identification) 
        {
            Power = 1
            hideChat(1)
            print("Robot successfully activated. To deactivate this robot type 'PowerDown' followed by this code: "+AI_Identification)
        }
    }

    if(Is_Owner) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"ActivateAll" ) 
        {
            Power = 1
            hideChat(1)
            print("All robots successfully activated")
        }
    }

    if(Is_Owner) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"PowerDown"+AI_Identification) 
        {
            Power = 0
            hideChat(1)
            print("Robot successfully powered down. To activate this robot type 'Activate' followed by this code: "+AI_Identification)
        }
    }

    if(Is_Owner) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"DeactivateAll" ) 
        {
            Power = 0
            hideChat(1)
            print("All robots successfully deactivated")
        }
    }

    if(Is_Owner) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"WipeTeams" ) 
        {
            print("Entities wiped: " + Teams[1, array]:count())
            Teams[1, array] = array()
            hideChat(1)
            print("Teams succesfully Whiped! | Left over: " + Teams[1, array]:count())
        }
    }
    
    if(Is_Owner) 
    { 
        if(TEMPLAR[1, string] == CommandPrefix+"AddToTeam" ) 
        {
            if(Components_3_Completed == 1) 
            {
                # Add each entity from Components_3 individually
                foreach(Tmp:number, Ent:entity=Components_3) {
                    Teams[1, array]:pushEntity(Ent)
                }
                print(Teams[1, array]:count())
                print("Successfully added to team!")
            } else { print("Failed to add to team!") }
            hideChat(1)
        }
    }

    if(Power == 1) 
    {
        # Manual Over Ride (MOR)
        if(Is_Owner) 
        { 
            if(TEMPLAR[1, string] == CommandPrefix+"MOR"+AI_Identification)
            {
                ManualOverRide = 1
                hideChat(1)
                print("Manual over-ride activated")
            } 
        }

        if(Is_Owner) 
        { 
            if(TEMPLAR[1, string] == CommandPrefix+"SetWayPoint") 
            {
                WayPoint_Exists = 1
                
                WayPoint_List:pushVector(round(Ply:pos()))
                WayPoint = WayPoint_List[1, vector]
                
                if(WayPoint_List:exists(1)) 
                {
                    foreach(TempVar_2:number, TempVa_3:vector=WayPoint_List) 
                    {  
                        holoCreate(600+TempVar_2)  
                        holoPos(600+TempVar_2, TempVa_3)  
                        holoColor(600+TempVar_2, vec(255, 0, 0))
                    }
                }
        
                hideChat(1)
                print("Set waypoint to: "+round(WayPoint):toString())
            } 
        }
    
        # Manual Over Ride All (MORA)
        if(Is_Owner) 
        { 
            if(TEMPLAR[1, string] == CommandPrefix+"MORA") 
            {
                ManualOverRide = 1
                hideChat(1)
                print("Manual over-rided all robots")
            }
        }
    
        # Opposite of MOR: "Ease Of Controls" (EOC)
        if(Is_Owner) 
        { 
            if(TEMPLAR[1, string] == CommandPrefix+"EOC"+AI_Identification)
            {
                ManualOverRide = 0
                Follow = 0
                hideChat(1)
                print("Manual over-ride de-activated")
            }
        }
    }
        
    if(ManualOverRide == 1) 
    {
        if(Is_Owner) 
        { 
            # Forces a singular robot follow you.
            if(TEMPLAR[1, string] == CommandPrefix+"Follow"+AI_Identification)
            {
                Follow = 1
                hideChat(1)
                print("Robot is now following you...")
            }
        }
            
        if(Is_Owner) 
        { 
            # Makes all robots follow you.
            if(TEMPLAR[1, string] == CommandPrefix+"FollowAll") 
            {
                Follow = 1
                hideChat(1)
                print("All robots are now following you...")
            }
        }
            
        if(Is_Owner) 
        { 
            # Stops all robots from following.
            if(TEMPLAR[1, string] == CommandPrefix+"StopFollowAll") 
            {
                Follow = 0
                hideChat(1)
                print("All robots stopped following.")
            }
        }

        if(Is_Owner) 
        { 
            # Disables targeting.
            if(TEMPLAR[1, string] == CommandPrefix+"TargetingOff"+AI_Identification) 
            {
                Targeting = 0
                hideChat(1)
                print("Successfully disabled targeting")
            }
        }

        if(Is_Owner) 
        { 
            # Disables movement.
            if(TEMPLAR[1, string] == CommandPrefix+"MovementOff"+AI_Identification) 
            {
                Movement = 0
                hideChat(1)
                print("Successfully disabled movement")
            }
        }
    }
}

