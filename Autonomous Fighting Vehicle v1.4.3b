        RangerFront = rangerOffsetHull(Self:toWorld(vec(0,0,20)), Self:toWorld(vec(0,Length + (Speed * 20),60)), RangerFrontHullSize)
        RangerBack = rangerOffsetHull(Self:toWorld(vec(0,0,20)), Self:toWorld(vec(0,-Length,60)), RangerBackHullSize)
        rangerPersist(0)
        rangerFilter(Components)
        rangerHitWater(0)
        rangerPersist(1)
        RangerGroundCheck_Front = rangerOffsetHull(Self:toWorld(vec(0,((Length + (Speed * 7)) / 2),128)), Self:toWorld(vec(0,(Length + (Speed * 7)),-Length)), vec(1))
        RangerGroundCheck_Back = rangerOffsetHull(Self:toWorld(vec(0,-((Length + (Speed * 7)) / 2),128)), Self:toWorld(vec(0,-(Length + (Speed * 7)),-Length)), vec(1))
        
