                    elseif(!Find_Array:exists(1) & !Find_Array[1, entity]:isValid()) 
                    { 
                        # Target = findClosest(Self:pos()) 
                        Target = findResult(TempResultIndex)                     
                    } 
                }
                
                if(Teams[2, array]:exists(1) & Teams[2, array][1, entity]:isValid() & !Target:isValid() & AnyfriendlyAI:isValid()) 
                { Target = Teams[2, array][1, entity] }
                    
                if(Is_Whitelisted & Target:isValid()) 
                { Teams[2, array] = array(), Teams[3, array] = array(), Target = noentity(), Is_Whitelisted = 0 }
                
                if(!Target:isValid() & Find_Array:count() == 0 & Teams[3, array]:count() == 0) { Target = noentity() }
        
                if(!Find_Array:count() & changed(Find_Array:count())) { Teams[3, array]:remove(1) }
            
                if(AnyfriendlyAI:isValid()) 
                {
                    if(Target:isValid() & changed(Target:id())) 
                    { 
                        if((Target:acfIsAmmo() & (Target:acfAmmoType() == "Refill")) | (Whitelist[Target:steamID(), number] | Whitelist[Target:owner():steamID(), number]))  
                        { print("CAUGHT YOU! 1"), Target = noentity() } 
                        else { Teams[2, array]:pushEntity(Target), print("SHARING TARGET") } 
                    }        
                }
                
                
                if(Teams[2, array]:exists(1)) 
                {
                    foreach(TempVar_6:number, TempVar_7:entity=Teams[2, array]) 
                    {  
                        if(!TempVar_7:isValid() & Teams[2, array]:exists(TempVar_6)) { Teams[2, array]:remove(TempVar_6) }
                        if(!TempVar_7:isAlive() & TempVar_7:isPlayer() & Teams[2, array]:exists(Teams[2, array]:indexOf(TempVar_7))) 
                        { 
                            findDisallowEntity(TempVar_7), findExcludeEntity(TempVar_7), Teams[2, array]:remove(Teams[2, array]:indexOf(TempVar_7))# , print("RESURRECTION!")
                            break 
                        }
                    }
                }
                
                if(!Refill) 
                {
            
                    if((Target:acfIsAmmo()) & (Target:acfAmmoType() == "Refill")) 
                    { Targetlist_2:pushEntity(Target), findExcludeEntities(Targetlist_2), Target = noentity() } 
                }
            
                if(Target:isValid() & Flankpos == vec(0)) 
                {
                    updatePosition()
                
                } elseif(!Target:isValid() & Follow == 1) 
                {
                    updatePosition_2()
                } 
        
                rangerPersist(0)
                stoptimer("Scan")
            }
        }
        
        holoPos(586, RadarBase:toWorld(vec(RadarDistance, -12, 0)))
        holoAng(586, RadarBase:angles() - ang(90, 0, 0))
        holoScale(586, vec(RadarRadius/12, RadarRadius/12, RadarDistance/142))
        
        ## Flanking:
        if(Target:isValid() & changed(Target:id())) { Flank = round(random(-1, 6)) }
        
        if(Flank == 4) { Flankpos = vec(900, 0, 0) } 
        elseif(Flank == 3) { Flankpos = vec(-900, 0, 0) } 
        elseif(Flank == 2) { Flankpos = vec(0, 900, 0) } 
        elseif(Flank == 1) { Flankpos = vec(0, -900, 0) }
        else { Flankpos = vec(0) }
                
        if(Target:isValid()) 
        {
            HUNT = 1
            Distance = Base_Pos:distance(TarPos)
            Gun_Target_Bearing = Turret:bearing(TarPos)
            Prev_Target_Pos = Target:pos()
            Aim = 1
        } else 
        { 
            Gun_Target_Bearing = 0
            HUNT = 0
            Distance = 0
            Aim = 0
        }
        
        if(Aim && changed(Aim)) 
        { TurretAng = Self:toLocal(Turret:angles()), TurretAng2 = Self:toLocal(TopMount_Turret:angles()) }
        
        ## Scanner lighting:
        
        if(changed(Target) & Target) 
        { Lightscan = 1
            
            Scannerlight = vec(255, 0, 0) soundPlay(2, 0.682, "npc/scanner/cbot_servoscared.wav")
            
        }
        
        elseif(changed(Target) & !Target) { Lightscan = 1
            
            timer("Calmer1", 5000)  if(!clk("Calmer1")) { Scannerlight = vec(255, 191, 0) soundPlay(1, 1.516, "npc/dog/dog_growl2.wav") }
        }
        
        if(clk("Calmer1")) { Scannerlight = vec(45, 255, 0), timer("Calmer2", 5000) }
        if(clk("Calmer2")) { Lightscan = 0, stoptimer("Calmer1") stoptimer("Calmer2") }

        ## Targeting Bearing

        if(Follow) { FollowDistance = Base_Pos:distance(Overseer:pos()) }
        else { FollowDistance = 0 }
        
        if(HasTeam & AnyfriendlyAI:isValid()) { Friendly_AI_FollowDistance = Base_Pos:distance(AnyfriendlyAI:pos()) }
        else { Friendly_AI_FollowDistance = 0 }
        
        local FROM_CHIP_TO_BASE = ((Base_Pos + Self_Right) - Base_Pos):toAngle()
        
        if((HUNT == 1) | (Follow == 1) | (HasTeam == 1) | (Force_Target == 1) | (Refill == 1) | (INVESTIGATE == 1)) 
        {
            if(!Target:isValid() & Force_Target) 
            { 
                if(Base_Pos:distance(Overseer_TargetTo) < 200) 
                {
                    hint("REACHED POINT", 3)
                    Force_Target = 0
                }
                HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, Overseer_TargetTo) 
            }
            elseif(!Target:isValid() & WayPoint_List:exists(1)) 
            {
                HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, WayPoint)
                if(Self:pos():distance(WayPoint) < 150) 
                { print("REACHED POINT"), WayPoint_List:remove(1), holoDelete(601) }
            }
            elseif(Follow & (FollowDistance > PreferredFollowRadius) & !Target:isValid()) 
            { 
                HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, owner():pos())
            }
            elseif(Follow & (FollowDistance < PreferredFollowRadius) & !Target:isValid()) 
            { 
                HuntY = (bearing(Base_Pos, FROM_CHIP_TO_BASE, owner():pos())/-1)
            }
            elseif(!Target:isValid() & AnyfriendlyAI:isValid() & HasTeam & (Friendly_AI_FollowDistance < Friendly_AI_PreferredFollowRadius_Threshold) & !Scouts[4, array]:exists(1)) 
            { 
                HuntY = (bearing(Base_Pos, FROM_CHIP_TO_BASE, AnyfriendlyAI:pos())/-1)
                # print("POOP")
            } 
            elseif(!Target:isValid() & AnyfriendlyAI:isValid() & HasTeam & (Friendly_AI_FollowDistance > Friendly_AI_PreferredFollowRadius) & !Scouts[4, array]:exists(1)) 
            { 
                HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, AnyfriendlyAI:pos())
                # print("SHIT")
            } 
            elseif(Target:isValid() | INVESTIGATE) 
            {   if(!Refill) 
                {   if(!INVESTIGATE) 
                    {
                        if(Distance <= 3000) 
                        {
                            timer("Random_Flank", 7000)
                            if(clk("Random_Flank")) 
                            {
                                Flank = round(random(-1, 6))
                                # print("FLANKY: " + Flank:toString())
                                stoptimer("Random_Flank")
                            }
                            
                            if(Flankpos == vec(0)) 
                            { HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, holoEntity(417):pos()) } 
                            else 
                            { 
                                local Temp_FlankPos = (Target:pos()-Flankpos)
                                local Distance_To_Flank = Temp_FlankPos:distance(Self:pos())
                                if(Distance_To_Flank <= 120) { Flank = round(random(-1, 6)) }
                                HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, Temp_FlankPos)
                                
                                holoPos(417, Temp_FlankPos)
                                
                            }
                        } else 
                        {
                            HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, TarPos)
                        }
                    } elseif(INVESTIGATE) 
                    {
                        HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, Prev_Target_Pos)
                    }
                } elseif(Refill) 
                {
                    HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, TarPos)
                }
            } 
            elseif(Refill) 
            {
                HuntY = bearing(Base_Pos, FROM_CHIP_TO_BASE, Targetlist_2[1, entity]:pos())
            } else { HuntY = 0 }
        } else { HuntY = 0 }
        
        ### The following is for attacking & aiming:
#[        if(((Distance < 50000) & (Distance != 0)) & ((HUNT == 1) | (Protect == 1))) {
            Aim = 1
        }
        else { 
            Aim = 0
        }]#
        
        # local Time_Till_Forget_Remember_Step = (clamp(((Distance + 1) / 25000), 0, 1) + 1)
        local Time_Till_Forget_Remember_Step = (clamp(((Distance + 1) / 25000), 0, 1) + 1)
        
        # if(Target:isValid()) { Time_Till_Forget = clamp((Time_Till_Forget * clamp((((Distance + 1) / 25000) * 10), 0, 1)), 0, Default_Time_Till_Forget)  }
        # if(Target:isValid()) { Time_Till_Forget = clamp((Time_Till_Forget * (clamp(((Distance + 1) / 25000), 0, 1)) + 1), 0, Default_Time_Till_Forget)  }
        # if(Target:isValid()) { Time_Till_Forget = clamp((Time_Till_Forget * Time_Till_Forget_Remember_Step), 0, Default_Time_Till_Forget)  }
        
        if(Target:isValid()) { Time_Till_Forget_Variance = clamp((Time_Till_Forget * Time_Till_Forget_Remember_Step), 0, Max_Remember_Time)  }
        
        if(!Target:isValid()) 
        { 
            if(Time_Till_Forget_Variance < Default_Time_Till_Forget) 
            { 
                Time_Till_Forget_Variance = clamp((Time_Till_Forget_Variance + Time_Till_Forget_Memory_Step), 0, Default_Time_Till_Forget) 
            } 
            
            if(Time_Till_Forget_Variance > Default_Time_Till_Forget) 
            { 
                Time_Till_Forget_Variance = clamp((Time_Till_Forget_Variance - Time_Till_Forget_Memory_Step), Default_Time_Till_Forget, Max_Remember_Time) 
            } else { Time_Till_Forget_Variance = Default_Time_Till_Forget }
        }
        
        Time_Till_Forget_Variance = round(Time_Till_Forget_Variance)
        
        # print(vec2(Time_Till_Forget_Variance, Time_Till_Forget_Remember_Step))
        
        if(changed(Target:isValid())) 
        { 
            MEMORY_SNAPSHOT = Time_Till_Forget_Variance# , print("REMEMBER FOR THIS LONG: " + MEMORY_SNAPSHOT:toString()) 
        }
        
        ## Turret aiming:
        if(Aim == 1 | (Follow == 0 & Protect != 0)) 
        # if(Aim == 1)
        {
            if(Target) 
            {
                ActivateTurret = 1
                timer("Aim", Aim_Frequency)
                
                if(clk("Aim"))
                {
                    Slope = 0.87
                    Intercept = 0.68  
                    #DT = 0.2
                    DT = (Aim_Frequency / 1000)
                    TarVel = ($TarPos / DT)
                    GunPos = Turret:pos()
                    Dist = (GunPos:distance(TarPos))
                    local BasePlate_Vel = Base:vel()
                    local Temp_Index_2 = round(distance_to_index(Dist, 50000, Ballistics_Table_Elevation_Array[Turret:acfAmmoType(), table]:count()))
                    local True_Drop = Ballistics_Table_Elevation_Array[Turret:acfAmmoType(), table][Temp_Index_2, number]
                    T = Ballistics_Table_Travel_Time_Array[Turret:acfAmmoType(), table][Temp_Index_2, number]
                    Coef = Dist * Slope / 10000 + Intercept
                    Lead = (TarVel * Coef * T)
                    Drift = round(BasePlate_Vel * T)
                    Drop = True_Drop
                    AimPos = (TarPos + Lead + vec(0,0,Drop) + Drift) 
        
                    # local Temp_Array = Components:merge(LOS_Filter)
        
                    rangerPersist(0)
                    rangerFlags("W E")
                    rangerFilter(Components)
                    rangerFilter(LOS_Filter)
                    # rangerFilter(Temp_Array)
                    rangerPersist(1)
                    LOSranger =  rangerOffsetHull(50000, GunPos, (Target:massCenter() - GunPos):normalized(), vec(8))
                    # LOSranger =  rangerOffsetHull((Dist+72), GunPos, (TarPos - GunPos):normalized(), vec(6))
                    
                    local Temp_GunAngles = GunAngles      
                    GunAngles = Turret:angles()      
                
                    local AngularVelocity = (-(GunAngles - Temp_GunAngles) / 0.1)
                    local AngularVelocity_Yaw = abs(AngularVelocity:yaw())
                    
                    if(abs(Base:angVel():yaw()) > AngularVelocity_Yaw) 
                    { Stabilise_Boost = mph_to_degrees_per_second(abs(Base:angVelVector():length() / 17.6)) }
                    elseif(abs(Base:angVel():yaw()) < AngularVelocity_Yaw)  
                    { Stabilise_Boost = 0 } else { Stabilise_Boost = 0 } 
                    
                    GunDir = (TarPos + Lead + vec(0,0,Drop) - Drift - GunPos):normalized()   
                    # local GunDir = (GunPos -  (TarPos - Lead - vec(0, 0, -Drop) - Drift)) 

                    AimPos = (TarPos + Lead + vec(0,0,Drop)) 
                    
                    TurretAng = angnorm(clamp(TurretAng - clamp(heading(vec(), TurretAng, Self:toLocalAxis(GunDir)), -(abs(RotateSpeed+Stabilise_Boost)), abs(RotateSpeed+Stabilise_Boost)), ang(-MaxElevation,-MinYaw, 0), ang(MaxDepression, MaxYaw, 0)))
                    
                    GunYaw = Self:toWorld(ang(0, clamp(TurretAng:yaw(), -MinYaw, MaxYaw), 0))
                    GunPitch = ang(clamp(TurretAng:pitch(), -MaxElevation, MaxDepression), 0, 0)
                    
                    holoAng(5, GunYaw)
                    holoAng(6, holoEntity(5):toWorld(GunPitch))  
                    
                    if(TopMount_Turret:isValid() & TopMount_Haxis:isValid() & TopMount_Vaxis:isValid()) 
                    {   local GunPos2 = TopMount_Turret:pos()
                        local Dist2 = (GunPos2:distance(TarPos))
                        local Drop2_Index = round(distance_to_index(Dist2, 50000, Ballistics_Table_Elevation_Array[TopMount_Turret:acfAmmoType(), table]:count()))
                        local Drop2 = Ballistics_Table_Elevation_Array[TopMount_Turret:acfAmmoType(), table][Drop2_Index, number]

                        local GunDir2 = (TarPos + vec(0,0,Drop2) - GunPos2):normalized()   
                        
                        TurretAng2 = angnorm(clamp(TurretAng2 - clamp(heading(vec(), TurretAng2, Self:toLocalAxis(GunDir2)), -(abs(RotateSpeed+Stabilise_Boost)), abs(RotateSpeed+Stabilise_Boost)), ang(-TopMount_MaxElevation,-TopMount_MinYaw, 0), ang(TopMount_MaxDepression, TopMount_MaxYaw, 0)))
                        
                        GunYaw2 = Self:toWorld(ang(0, clamp(TurretAng2:yaw(), -TopMount_MinYaw, TopMount_MaxYaw), 0))
                        GunPitch2 = ang(clamp(TurretAng2:pitch(), -TopMount_MaxElevation, TopMount_MaxDepression), 0, 0)
                        
                        holoAng(115, GunYaw2)
                        holoAng(116, holoEntity(115):toWorld(GunPitch2))  
                    }                       

                    local Insight = LOSranger:entity()
                    
                    rangerPersist(0)
                    
                    if(!Refill & Insight:isValid() & !(Whitelist[Insight:owner():steamID(), number] | Whitelist[Insight:steamID(), number])) 
                    { LOS_Time = LOS_Time + 1
                        if((!Target:isPlayer() | (Distance > 4000)) & (LOS_Time > LOS_Fire_Threshold) | ((CoaxGun:acfAmmoCount() <= 0) & (CoaxGun:acfMagRounds() <= 0))) 
                        { 
                            TurretFire = !TurretFire
                            if(Distance < 2000) 
                            { CoaxFire = 1 } else { CoaxFire = 0 }
                            RepeatOnFinish = 1, ForceCancel = 0 
                            if((LOS_Time > LOS_FireMissile_Threshold) & TopMount_Turret:acfReady()) 
                            { 
                                Reload_Missile = 0, MissileFire = 1# , print("FIRE MISSILE")
                            } else { Reload_Missile = 1, MissileFire = 0 }
                        } 
                        else { TurretFire = 0, CoaxFire = 1, RepeatOnFinish = 1, ForceCancel = 0 } 
                    } 
                    else { Reload_Missile = 1, TurretFire = 0, CoaxFire = 0, MissileFire = 0, RepeatOnFinish = 0, ForceCancel = 1, LOS_Time = 0 }
                                
                    if(Insight:isValid() & Insight:id() != Target:id()) 
                    { 
                        LOS_Filter:pushEntity(Insight)# , print(LOS_Filter:indexOf(Insight)) 
                    }
                    
                    if(LOS_Filter:exists(1)) 
                    { 
                        if(LOS_Filter:indexOf(Target)) 
                        { # print("NOT SUPPOSED TO DO THIS!")
                        LOS_Filter:remove(LOS_Filter:indexOf(Target)) 
                        } 
                    }
                    
                    # if(changed(Insight) & (Insight:id() == Target:id())) 
                    if(changed(Insight) & Insight)                     
                    { 
                        # Teams[3, table]:remove(Teams[3, table]:count())
                        Teams[3, table]:pushString("True")
                        # print("TRUE")
                    } 
                    
                    if(changed(Insight) & !Insight) 
                    { 
                        # Teams[3, table]:remove(Teams[3, table]:count())
                        Teams[3, table]:pushString("False")
                        # print("FALSE")
                    } 
                    
                    if(Teams[3, table]:count()) 
                    {
                        # local Temp_Index_2 = 0
                        # local Temp_True_Or_False = 0
                        foreach(Temp_Index_2:number, True_Or_False:string=Teams[3, table]) 
                        { 
                            # Temp_Index_2 = Temp_Index_2 + 1
                            # if(Teams[3, table][Temp_Index_2, string] == "False") 
                            # {                        
                            #     Temp_True_Or_False = Temp_True_Or_False + 1
                            #     print("!!! OUT OF LINE OF SIGHT !!!")
                            # }
                            
                            if(True_Or_False == "False") 
                            {
                                # print("!!! OUT OF LINE OF SIGHT !!!")
                                
                                Temp_True_Or_False = Temp_True_Or_False + 1
                            }
                            
                            if(Temp_True_Or_False >= Teams[3, table]:count()) 
                            { 
                                Target = noentity()
                                Find_Array = array()
                                Teams[2, array] = array()
                                Teams[3, array] = array()
                                Teams[3, table] = table()
                                
                                Temp_True_Or_False = 0
                                
                                # print("NO FRIENDLIES HAVE LINE OF SIGHT! FORGETTING")
                            }                            
                            
                            if(Temp_Index_2 >= Teams[3, table]:count()) { break }
                        }
                        
#[                        if(Temp_True_Or_False >= Teams[3, table]:count()) 
                        { 
                            Target = noentity()
                            Find_Array = array()
                            Teams[2, array] = array()
                            Teams[3, array] = array()
                            Teams[3, table] = table()
                            
                            Temp_True_Or_False = 0
                            
                            print("NO FRIENDLIES HAVE LINE OF SIGHT! FORGETTING")
                        }]#
                    }
                    
                    if(Teams[3, table]:count() > AI_Team_Members[1, table]:count()) 
                    { 
                        # Teams[3, table] = table()
                        Teams[3, table]:remove(Teams[3, table]:count())
                        # print("PRUNING")
                    }
                                
                    rangerPersist(0)
                    stoptimer("Aim")
                }
            }
        }
        else 
        { TurretFire = 0, CoaxFire = 0, Reload_Missile = 1, MissileFire = 0, ActivateTurret = 0, RepeatOnFinish = 0, ForceCancel = 1, Temp_True_Or_False = 0, LOS_Time = 0
            if(LOS_Filter:exists(1) & (LOS_Filter:count() > Components:count())) 
            {
                # foreach(TempVar_14:number, TempVar_15:entity=LOS_Filter) 
                # {  
                #     if(!TempVar_15:isValid() & LOS_Filter:exists(TempVar_14)) { LOS_Filter:remove(TempVar_14) }
                # }
                
                LOS_Filter = Components
            }
            
            local AngleTolerance = 1.5
            
            local AngDiff = angnorm(TurretAng - OG_GUN_ANG)
            
            local AtRestAngle = (abs(AngDiff:pitch()) < AngleTolerance & abs(AngDiff:yaw()) < AngleTolerance)
            
            if(AtRestAngle & Set_Turret_Back) {
                Set_Turret_Back = 0
                # print("REACHED OG ANG")
            }
            
            if(Set_Turret_Back) 
            { 
                timer("Aim", Aim_Frequency)
                
                if(clk("Aim"))
                {
                    # print("AHAHAHAHAHAHHJAAJJJJJ")
                    GunDir = Self:toWorldAxis(OG_GUN_ANG:forward())
                    
                    TurretAng = angnorm(clamp(TurretAng - clamp(heading(vec(), TurretAng, Self:toLocalAxis(GunDir)), -RotateSpeed, RotateSpeed), ang(-MaxElevation,-MinYaw, 0), ang(MaxDepression, MaxYaw, 0)))
                    
                    GunYaw = Self:toWorld(ang(0, clamp(TurretAng:yaw(), -MinYaw, MaxYaw), 0))
                    GunPitch = ang(clamp(TurretAng:pitch(), -MaxElevation, MaxDepression), 0, 0)
                    
                    holoAng(5, GunYaw)
                    holoAng(6, holoEntity(5):toWorld(GunPitch))
                    
                    stoptimer("Aim")
                }
            }
        }
        
        if(Target:isValid()) 
        {
            holoAng(587, (Target:boxCenterW() - RadarBase_Pos):toAngle())
            Set_Turret_Back = 0
            Remembrance = 0
            INVESTIGATE = 0
            timer("Remembrance", 100)
        } elseif(!Target:isValid() & clk("Remembrance")) 
        { # print("REMEMBER IT BRO")
            Set_Turret_Back = 0
            Remembrance = 1
            INVESTIGATE = 1
            stoptimer("Remembrance")
        } elseif(Remembrance | Force_Target)
        {   
            # Pos_Switch = vec(0)
            if(Remembrance) { Pos_Switch = Prev_Target_Pos }
            if(Force_Target) { Pos_Switch = (Overseer_TargetTo + Base:toLocal(RadarBase_Pos)) }
            holoAng(587, ((Pos_Switch-RadarBase_Pos):toAngle()) + ang(random(-6, 6), random(-6, 6), random(-6, 6))) 
            if(Remembrance) 
            { 
                timer("Aim", Aim_Frequency)
                
                if(clk("Aim"))
                {   
                    GunPos = Turret:pos()
                    # print("6967 AHAHAHAHAHAHHJAAJJJJJ")
                    GunDir = (Pos_Switch - GunPos):normalized() 
                    
                    TurretAng = angnorm(clamp(TurretAng - clamp(heading(vec(), TurretAng, Self:toLocalAxis(GunDir)), -RotateSpeed, RotateSpeed), ang(-MaxElevation,-MinYaw, 0), ang(MaxDepression, MaxYaw, 0)))
                    
                    GunYaw = Self:toWorld(ang(0, clamp(TurretAng:yaw(), -MinYaw, MaxYaw), 0))
                    GunPitch = ang(clamp(TurretAng:pitch(), -MaxElevation, MaxDepression), 0, 0)
                    
                    holoAng(5, GunYaw)
                    holoAng(6, holoEntity(5):toWorld(GunPitch))
                    
                    stoptimer("Aim")
                }
                
                timer("Forget", MEMORY_SNAPSHOT)
            } 
            if(clk("Forget")) 
            { # print("I FORGOR")
                Remembrance = 0
                Prev_Target_Pos = vec(0)
                INVESTIGATE = 0
                Set_Turret_Back = 1
                stoptimer("Forget")
            }
        } elseif(!Target & !Target:isValid() & !Remembrance) 
        {   
            # local RadarDistance_Factor = round((1 - (RadarDistance / 50000)), 2)
            local RadarDistance_Factor = round((RadarDistance / 25000), 2)
            # print(vec2(RadarDistance, RadarDistance_Factor))
            # print(RadarDistance_Factor)
            local Temp_Chip_Angles = entity():angles()
            local Temp_Roll = Temp_Chip_Angles:roll()
            local Temp_Pitch = Temp_Chip_Angles:pitch()  
            # holoAng(587, Base:toWorld(ang((random(-RADAR_PITCH_MAX, RADAR_PITCH_MAX) / RadarScanRotationRate), (RadarScanRotation*  RadarScanRotationRate), 0)))
            # holoAng(587, Base:toWorld(ang(((RADAR_PITCH_MAX * SinTime) / RadarScanRotationRate), (RadarScanRotation * RadarScanRotationRate), 0)))
            ##### holoAng(587, Base:toWorld(ang((((RADAR_PITCH_MAX * SinTime) * RadarDistance_Factor) / RadarScanRotationRate), (RadarScanRotation * RadarScanRotationRate), 0)))
            holoAng(587, Base:toWorld(ang(clamp((((RADAR_PITCH_MAX * SinTime) * RadarDistance_Factor) / RadarScanRotationRate), -RADAR_PITCH_MAX, RADAR_PITCH_MAX), (RadarScanRotation * RadarScanRotationRate), 0)))
            if(RadarScanRotation < 360) { RadarScanRotation++ } 
            else { RadarScanRotation = 0 } 
        }
    }

### Raycasts: ####---------------------------------------------------------------------------####
### Raycasts: ####---------------------------------------------------------------------------####
### Raycasts: ####---------------------------------------------------------------------------####

    timer("Raycast", Ray_Frequency)
    if(clk("Raycast")) 
    {
        if(Components:count() & changed(Components:count())) { print("Readjusting Components: " + Components:count()), Components = Base:getConnectedEntities() }
        
        rangerPersist(0)
        rangerFilter(Components)
        rangerHitWater(1)
        rangerHitEntities(1)
        rangerPersist(1)
        RangerLeft = rangerOffsetHull(Self:toWorld(vec(0,-50,10)), Self:toWorld(vec(-480,500,20)), RangerLeftHullSize)
