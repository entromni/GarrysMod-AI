                        print("WTF LOL")
                        Overseer_System["Commands", table]["AI_Individual_Commands_Data", table][AI_Identification, table]["Resolved?", number] = 1 
                    }
                }
                
                if(Resolved_Status) 
                {                
                    Overseer_System["Commands", table]["AI_Individual_Commands_Data", table]:remove(AI_Identification)
                    stoptimer("Command_Delay")
                }
            }
        }
    }
